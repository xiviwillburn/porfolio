---
import { Image } from 'astro:assets';
import what from '../../assets/Sanguinaria.png';
import Card from '../Card.astro';
---

<div class="item">
    <Card
        title="Sanguinaria"
        body="Gameplay/Technical Audio"
        steam="https://store.steampowered.com/app/2984200/Sanguinaria/"
    >
        <div>
            <Image
                class="project-image border  border-black"
                src={what}
                alt=""
                densities={[1, 2, 3]} 
            />
            <style>
            .project-image {
                width: 100%;
                height: auto;
            }
            </style>
        </div>
    </Card>
</div>



